{
  "name": "ocuclaw",
  "version": "2.2.0",
  "requiresClientVersion": "2.2.0",
  "description": "OcuClaw for Even Realities G2 smart glasses.",
  "homepage": "https://ocuclaw.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocuclaw/ocuclaw-openclaw-plugin.git"
  },
  "bugs": {
    "url": "https://ocuclaw.com/support"
  },
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "CONFIGURATION.md",
    "NOTICE.md",
    "README.md",
    "dist/",
    "openclaw.plugin.json",
    "registry/",
    "skills/"
  ],
  "keywords": [
    "even",
    "evenrealities",
    "even-g2",
    "glasses",
    "openclaw",
    "plugin",
    "ocuclaw"
  ],
  "engines": {
    "node": ">=20"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:ocuclaw",
      "npmSpec": "ocuclaw",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.5"
    },
    "compat": {
      "pluginApi": ">=2026.9.5 <2028.0.0"
    },
    "build": {
      "openclawVersion": "2026.9.5",
      "pluginSdkVersion": "2026.9.5",
      "bundledDist": true
    }
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "fflate": "^0.8.3",
    "marked": "^18.0.7",
    "meshoptimizer": "1.3.0",
    "undici": "^6.29.1",
    "ws": "^8.21.1"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "generate:template-registry": "node ./scripts/generate-template-registry.mjs",
    "check:template-registry": "node ./scripts/generate-template-registry.mjs --check",
    "generate:liveui-registry": "node ./scripts/generate-liveui-registry.mjs",
    "check:liveui-registry": "node ./scripts/generate-liveui-registry.mjs --check",
    "sync:assist": "node ./scripts/sync-assist-skill.mjs",
    "prepare": "node ./scripts/build.mjs",
    "test:unit": "node --import ./scripts/test-loader.mjs --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
